 as dw_update_ts    from order_detail_source od    inner join order_header_source oh        on od.order_id = oh.order_id    left join dim_location_lookup dl        on oh.location_id = dl.location_id    left join dim_truck_lookup dt        on oh.truck_id = dt.truck_id    left join dim_customer_lookup dc        on oh.customer_id = dc.customer_id)select * from fact_sales
