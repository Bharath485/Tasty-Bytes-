with menu_data as (
    select
        cast(menu_item_id as integer) as menu_item_id,
        cast(item_category as varchar) as item_category
    from tasty_bytes_dbt_db.RAW.MENU
),

order_detail_aggregated as (
    select
        cast(menu_item_id as integer) as menu_item_id,
        sum(cast(quantity as integer)) as quantity_sold,
