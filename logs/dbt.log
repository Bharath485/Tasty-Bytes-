    cast(PRICE as decimal(10,2)) as line_gross_amount,
    cast(coalesce(ORDER_ITEM_DISCOUNT_AMOUNT, 0) as decimal(10,2)) as line_discount_amount,
    cast(PRICE - coalesce(ORDER_ITEM_DISCOUNT_AMOUNT, 0) as decimal(10,2)) as line_net_amount,
    cast(ORDER_TAX_AMOUNT as decimal(10,2)) as header_tax_amount,
    cast(trim(upper(ORDER_CHANNEL)) as varchar(50)) as order_channel,
    cast(upper(ORDER_CURRENCY) as varchar(3)) as order_currency,
    cast(DISCOUNT_ID as integer) as discount_id,
    cast(current_timestamp() as timestamp) as dw_insert_ts,
    cast(current_timestamp() as timestamp) as dw_update_ts
from joined_data
  )
