        od.ORDER_DETAIL_ID,
        od.ORDER_ID,
        oh.ORDER_TS,
        oh.LOCATION_ID,
        oh.TRUCK_ID,
        oh.CUSTOMER_ID,
        od.QUANTITY,
        od.UNIT_PRICE,
        od.PRICE,
        od.ORDER_ITEM_DISCOUNT_AMOUNT,
        oh.ORDER_TAX_AMOUNT,
        oh.ORDER_CHANNEL,
        oh.ORDER_CURRENCY,
        od.DISCOUNT_ID
    from order_detail_source od
    left join order_header_source oh
        on od.ORDER_ID = oh.ORDER_ID
)

select
    cast(ORDER_DETAIL_ID as integer) as order_item_id,
    cast(ORDER_ID as integer) as order_id,
    cast(ORDER_TS as timestamp) as order_ts,
    cast(date_part('year', ORDER_TS) * 10000 + date_part('month', ORDER_TS) * 100 + date_part('day', ORDER_TS) as integer) as order_date_key,
    cast(LOCATION_ID as integer) as location_key,
    cast(TRUCK_ID as integer) as truck_key,
