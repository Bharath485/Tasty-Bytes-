        sum(price) as total_line_amount,
        sum(quantity) as total_quantity
    from dbt_poc.RAW.ORDER_DETAIL
    
        where order_id in (
            select order_id 
            from dbt_poc.RAW.ORDER_HEADER
            where order_ts > (select max(order_timestamp) from DBT_POC.DEV.FACT_ORDERS)
        )
    
    group by order_id
),

final as (
