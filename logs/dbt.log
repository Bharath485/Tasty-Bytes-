    header_tax_amount,
    
    -- Attributes
    order_channel,
    order_currency,
    cast(discount_id as varchar) as discount_id,
    
    -- System metadata
    current_timestamp() as dw_insert_ts,
    current_timestamp() as dw_update_ts
    
from joined_data
