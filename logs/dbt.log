    oh.order_tax_amount,
    oh.order_discount_amount,
    oh.order_total
FROM tasty_bytes_dbt_db.DEV.raw_pos_order_detail od
JOIN tasty_bytes_dbt_db.DEV.raw_pos_order_header oh
    ON od.order_id = oh.order_id
JOIN tasty_bytes_dbt_db.DEV.raw_pos_truck t
