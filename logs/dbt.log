    group by menu_item_id
)

select
    m.menu_item_id as menu_item_key,
    oda.quantity_sold,
    oda.total_sales_amount,
    m.item_category
from menu_data m
left join order_detail_aggregated oda
    on m.menu_item_id = oda.menu_item_id
    )

