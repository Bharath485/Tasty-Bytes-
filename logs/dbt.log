        cast(PRICE as decimal(18,2)) as price,
        cast(QUANTITY as integer) as quantity
    from tasty_bytes_dbt_db.RAW.ORDER_DETAIL
),

order_aggregations as (
    select
        order_id,
        sum(price) as total_line_amount,
        sum(quantity) as total_quantity
    from order_detail
    group by order_id
),

final as (
