with order_detail_source as (
    select
        order_detail_id,
        order_id,
        price
    from tasty_bytes_dbt_db.RAW.ORDER_DETAIL
),

order_header_source as (
    select
        order_id,
        order_ts,
        location_id,
        truck_id
    from tasty_bytes_dbt_db.RAW.ORDER_HEADER
),

dim_date_lookup as (
    select
        date_key,
        date
    from tasty_bytes_dbt_db.DEV.DIM_DATE
),

dim_location_lookup as (
    select
        location_key,
        location_id
    from tasty_bytes_dbt_db.DEV.DIM_LOCATION
),

dim_truck_lookup as (
    select
        truck_key,
        truck_id
    from tasty_bytes_dbt_db.DEV.DIM_TRUCK
),

joined_data as (
    select
        od.order_detail_id,
        od.order_id,
        oh.order_ts,
        oh.location_id,
        oh.truck_id,
        coalesce(od.price, 0) as price
    from order_detail_source od
    left join order_header_source oh
        on od.order_id = oh.order_id
),

final as (
    select
        cast(jd.order_detail_id as integer) as order_detail_id,
        cast(jd.order_id as integer) as order_id,
        cast(dd.date_key as integer) as date_key,
        cast(dl.location_key as integer) as location_key,
        cast(dt.truck_key as integer) as truck_key,
        cast(jd.price as decimal(10,2)) as line_sales_amount_usd
    from joined_data jd
    left join dim_date_lookup dd
        on date(jd.order_ts) = dd.date
    left join dim_location_lookup dl
        on jd.location_id = dl.location_id
    left join dim_truck_lookup dt
        on jd.truck_id = dt.truck_id
)

select
    order_detail_id,
    order_id,
    date_key,
    location_key,
    truck_key,
    line_sales_amount_usd
from final
